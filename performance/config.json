{
  "sitemapUrl": "https://experienceleague.adobe.com/sitemap-index.xml",
  "include": ["^https://experienceleague\\.adobe\\.com/en/"],
  "exclude": ["/search"],
  "select": "onePerType",
  "withinType": "hub",
  "pageTypes": [
    { "id": "home", "match": "/en/?$|/en/home(/|$)" },
    { "id": "browse", "match": "/en/browse(/|$)" },
    { "id": "events", "match": "/en/events(/|$)" },
    { "id": "playlists", "match": "/en/playlists(/|$)" },
    { "id": "perspectives", "match": "/en/perspectives(/|$)" },
    { "id": "courses", "match": "/en/courses(/|$)" },
    { "id": "certification", "match": "/en/certification" },
    { "id": "docs", "match": "/en/docs(/|$)" }
  ],
  "seed": 1,
  "formFactors": ["mobile", "desktop"],
  "query": {
    "martech": "off"
  },
  "shards": 4,
  "concurrencyPerShard": 1,
  "auditor": "lighthouse",
  "artifactRetentionDays": 45,
  "keepLastRuns": 8,
  "fetchTimeoutMs": 120000,
  "maxSitemapBytes": 52428800,
  "allowedHosts": ["experienceleague.adobe.com"],
  "sitemapConcurrency": 4
}
